{
  "modelVersion": "5.0.0",
  "dependencies": {
  },
  "properties": {
    "hvigor.dependency.useNpm": true
  },
  "execution": {
    "daemon": true,
    "incremental": true,
    "parallel": true,
    "typeCheck": false
  },
  "logging": {
    "level": "info"
  },
  "debugging": {
    "stacktrace": false
  },
  "nodeOptions": {
    "maxOldSpaceSize": 8192,
    "exposeGC": true
  }
}