{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "HMCL - Hello Minecraft! Launcher for HarmonyOS",
    "mainElement": "EntryAbility",
    "deviceTypes": ["default", "tablet", "2in1"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        "name": "ohos.permission.VIBRATE"
      },
      {
        "reason": "$string:perm_reason_download",
        "usedScene": {
          "abilities": ["EntryAbility", "GameAbility"],
          "when": "inuse"
        },
        "name": "ohos.permission.READ_WRITE_DOWNLOAD_DIRECTORY"
      },
      {
        "reason": "$string:perm_reason_file_persist",
        "usedScene": {
          "abilities": ["EntryAbility", "GameAbility"],
          "when": "inuse"
        },
        "name": "ohos.permission.FILE_ACCESS_PERSIST"
      },
      {
        "name": "ohos.permission.kernel.ALLOW_WRITABLE_CODE_MEMORY"
      },
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:perm_reason_microphone",
        "usedScene": {
          "abilities": ["GameAbility"],
          "when": "inuse"
        }
      }
    ],
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["ohos.want.action.home"]
          }
        ]
      },
      {
        "name": "GameAbility",
        "srcEntry": "./ets/gameability/GameAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": false,
        "orientation": "landscape",
        "launchType": "standard"
      }
    ]
  }
}
